    "from datetime import *\n",
    "d1='03/07/2019'\n",
    "d2='12/06/2018'\n",
    "d1date = datetime.strptime(d1, '%m/%d/%Y')\n",
    "d2date = datetime.strptime(d2, '%m/%d/%Y')\n",
    "if d1date < d2date:\n",
    "    print(\"ascending order\")\n",
    "else:\n",
    "    print(\"descending\")    "
   ]
