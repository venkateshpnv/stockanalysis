+def insert_df_from_hdf_to_influxdb(symbol, df, client):
+    df['Date'] = df.index.strftime("%Y-%m-%d")
+    client.write_points(df, symbol, tag_columns=['Date'], protocol='line', batch_size=1000)
+
+def insert_all_dfs_from_hdf_to_influxdb(country):
+    symbols = get_symbols_from_hdf(country)
+
+    for i, symbol in enumerate(symbols):
+        print("%d: %r"%(i, symbol))
+        df = read_from_hdf(country, symbol)
+        try:
+            client = DB.open_influx_client(country)
+            insert_df_from_hdf_to_influxdb(symbol, df, client)
+        finally:
+            DB.close_influx_client(client)
+        i = i + 1
+        if i > 100:
+            break
+
