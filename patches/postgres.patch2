+def insert_df_from_hdf_to_postgres(country, symbol, engine, schema):
+    cursor = engine.cursor()
+    df = read_from_hdf(country, symbol)
+    #df['Symbol'] = symbol
+    #symbol = symbol.replace('.','_')
+    symbol = schema+'.'+symbol.replace('.','_')
+    query = 'CREATE TABLE IF NOT EXISTS '+symbol+'(high decimal, low decimal, open decimal, close decimal, volume BIGINT, adj_close decimal, symbol char(20), Date timestamptz primary key);'
+    cursor.execute(query)
+    engine.commit()
+    #query = 'SELECT create_hypertable(%r, %r);' %(symbol, 'date')
+    #cursor.execute(query)
+    #engine.commit()
+    #query = 'select * from '+ schema+'.'+symbol
+    df.rename(columns={'Adj Close': 'Adj_Close'}, inplace=True)
+    df['Date'] = df.index
+    df_columns = list(df)
+    columns = ",".join(df_columns)
+    values = "VALUES({})".format(",".join(["%s" for _ in df_columns]))
+    insert_stmt = "INSERT INTO {} ({}) {} on conflict(\"date\") do nothing".format(symbol,columns,values)
+    psycopg2.extras.execute_batch(cursor, insert_stmt,df.values)
+    engine.commit()
+
+def insert_all_dfs_from_hdf_to_postgres(country):
+    symbols = get_symbols_from_hdf(country)
+    try:
+        if country == 'India':
+            engine = DB.open_postgres_con('india_stocks')
+        else:
+            engine = DB.open_postgres_con('us_stocks')
+        for i, symbol in enumerate(symbols):
+            #if i > 1113: #ALL, ASC, BY, ELSE
+            print("%d: %r"%(i, symbol))
+            insert_df_from_hdf_to_postgres(country, symbol, engine, 'prices')
+            if i > 10:
+                break;
+    finally:
+        DB.close_postgres_con(engine)
 
